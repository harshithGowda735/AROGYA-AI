{
  "expo": {
    "name": "DermAI",
    "slug": "dermai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.arogya.dermai",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DermAI to access your camera."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image-picker"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5fd94ba9-5625-4e7b-a071-d3f6c7d8e665"
      }
    },
    "scheme": "dermai",
    "owner": "harshithg"
  }
}
